        "text = \"The quick fox jumps slowly\"\n",
        "\n",
        "# Define regular expression tagging rules\n",
        "patterns = [\n",
        "    (r'^The$|^the$|^a$|^an$', 'DT'),\n",
        "    (r'.*ly$', 'RB'),\n",
        "    (r'.*ing$', 'VBG'),\n",
        "    (r'.*ed$', 'VBD'),\n",
        "    (r'.*s$', 'VBZ'),\n",
        "    (r'^[A-Z].*$', 'NNP'),\n",
        "    (r'.*', 'NN')\n",
        "]\n",
        "\n",
        "tagger = nltk.RegexpTagger(patterns)\n",
        "words = wordpunct_tokenize(text)\n",
        "\n",
        "print(tagger.tag(words))\n"
