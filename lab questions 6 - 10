        "\n",
        "# A simple probabilistic POS tagger\n",
        "\n",
        "tag_probabilities = {\n",
        "    \"the\": {\"DT\": 0.95, \"NN\": 0.05},\n",
        "    \"dog\": {\"NN\": 0.90, \"VB\": 0.10},\n",
        "    \"barks\": {\"VB\": 0.80, \"NN\": 0.20},\n",
        "    \"a\": {\"DT\": 0.98, \"NN\": 0.02},\n",
        "    \"cat\": {\"NN\": 0.95, \"VB\": 0.05},\n",
        "    \"runs\": {\"VB\": 0.75, \"NN\": 0.25}\n",
        "}\n",
        "\n",
        "def stochastic_tagger(sentence):\n",
        "    words = sentence.lower().split()\n",
        "    tagged_words = []\n",
        "\n",
        "    for word in words:\n",
        "        if word in tag_probabilities:\n",
        "            tag = max(\n",
        "                tag_probabilities[word],\n",
        "                key=tag_probabilities[word].get\n",
        "            )\n",
        "        else:\n",
        "            tag = \"NN\"\n",
        "\n",
        "        tagged_words.append((word, tag))\n",
        "\n",
        "    return tagged_words\n",
        "\n",
        "sentence = \"the dog barks\"\n",
        "print(stochastic_tagger(sentence))\n"
