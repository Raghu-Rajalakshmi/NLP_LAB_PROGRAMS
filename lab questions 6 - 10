        "\n",
        "# Simple transformation-based POS tagger\n",
        "\n",
        "def transformation_tagger(sentence):\n",
        "    words = sentence.split()\n",
        "\n",
        "    # Step 1: Assign an initial tag to every word\n",
        "    tagged = [(word, \"NN\") for word in words]\n",
        "\n",
        "    # Step 2: Apply transformation rules\n",
        "    for i, (word, tag) in enumerate(tagged):\n",
        "        lower = word.lower()\n",
        "\n",
        "        # Rule 1: Determiners\n",
        "        if lower in [\"the\", \"a\", \"an\"]:\n",
        "            tagged[i] = (word, \"DT\")\n",
        "\n",
        "        # Rule 2: Common auxiliary verbs\n",
        "        elif lower in [\"is\", \"am\", \"are\", \"was\", \"were\"]:\n",
        "            tagged[i] = (word, \"VB\")\n",
        "\n",
        "        # Rule 3: Words ending in \"ing\"\n",
        "        elif lower.endswith(\"ing\"):\n",
        "            tagged[i] = (word, \"VBG\")\n",
        "\n",
        "        # Rule 4: Words ending in \"ly\"\n",
        "        elif lower.endswith(\"ly\"):\n",
        "            tagged[i] = (word, \"RB\")\n",
        "\n",
        "        # Rule 5: Words ending in \"ous\"\n",
        "        elif lower.endswith(\"ous\"):\n",
        "            tagged[i] = (word, \"JJ\")\n",
        "\n",
        "    return tagged\n",
        "\n",
        "\n",
        "sentence = \"The dog is running quickly\"\n",
        "print(\"Transformed Tags:\")\n",
        "print(transformation_tagger(sentence))\n"
